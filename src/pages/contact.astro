---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import StubForm from '../components/StubForm.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { site, socials } from '../data/site';
import { event } from '../data/event';

const fields = [
  { type: 'text', name: 'name', label: 'Full name', required: true, half: true, autocomplete: 'name' },
  { type: 'email', name: 'email', label: 'Email', required: true, half: true, autocomplete: 'email' },
  { type: 'tel', name: 'phone', label: 'Phone', half: true, autocomplete: 'tel' },
  {
    type: 'select',
    name: 'subject',
    label: 'What can we help with?',
    half: true,
    required: true,
    options: ['Film production', 'Film marketing', 'Public relations', 'Event sponsorship', 'Tickets', 'Press & media', 'Booking Brooke', 'Training & yoga', 'Something else'],
  },
  { type: 'textarea', name: 'message', label: 'Your message', required: true, rows: 6 },
  { type: 'consent', name: 'consent', label: 'Yes, I agree to the <a href="/privacy-policy">Privacy Policy</a> and understand my information will be used to respond to my request.', required: true },
] as const;
---

<Base
  title="Contact"
  description="Get in touch with Forbes Productions — production, PR, sponsorship, press and booking enquiries."
>
  <PageHero
    eyebrow="Get in touch"
    title="Contact Us"
    lede="Let's create something extraordinary together. Get in touch to discuss your next project."
    media="forbis-production-1"
  />

  <section class="section">
    <div class="wrap layout">
      <aside class="side" data-reveal>
        <p class="eyebrow">Let&rsquo;s talk</p>
        <h2>However you<br /><span class="em">reach us</span></h2>
        <p class="lede">
          Whether you&rsquo;re planning a production, need PR support or want to collaborate, we&rsquo;re here to
          bring your vision to life.
        </p>

        <dl class="details">
          <div>
            <dt>E-mail address</dt>
            <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
          </div>
          <div>
            <dt>Phone number</dt>
            <dd><a href={`tel:${site.phoneHref}`}>{site.phone}</a></dd>
          </div>
          <div>
            <dt>Next event</dt>
            <dd>{event.venue}<br />{event.address}</dd>
          </div>
        </dl>

        <ul class="social" aria-label="Forbes Productions on social media">
          {socials.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label} title={s.label}>
                <SocialIcon icon={s.icon} />
              </a>
            </li>
          ))}
        </ul>

        <div class="map">
          <iframe
            title="Map showing The Kookaburra Lounge, 6801 Hollywood Blvd, Hollywood, CA"
            src={`https://www.google.com/maps?q=${event.mapQuery}&output=embed`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </aside>

      <div class="form-body card" data-reveal style="--reveal-delay:110ms">
        <StubForm
          id="contact"
          title="Send us a message"
          note="We read everything and reply to serious enquiries within two business days."
          fields={fields as any}
          submitLabel="Submit"
        />
      </div>
    </div>
  </section>
</Base>

<style>
  .em { font-style: italic; color: var(--gold-soft); }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: start;
  }

  .details {
    display: grid;
    gap: 1.25rem;
    margin: 2rem 0;
    padding-block: 1.75rem;
    border-block: 1px solid var(--line);
  }

  .details div { display: grid; gap: 0.3rem; }

  .details dt {
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .details dd { margin: 0; font-size: 1.02rem; color: var(--muted); line-height: 1.55; }
  .details a { color: var(--paper); text-decoration: none; }
  .details a:hover { color: var(--gold-soft); text-decoration: underline; }

  .social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0 0 2rem;
    padding: 0;
    list-style: none;
  }

  .social li { margin: 0; }

  .social a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    transition: color 0.25s var(--ease), background 0.25s var(--ease), border-color 0.25s var(--ease), transform 0.25s var(--ease);
  }

  .social a:hover { color: #fff; background: var(--red); border-color: transparent; transform: translateY(-2px); }

  .map {
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    overflow: hidden;
    aspect-ratio: 16 / 11;
    background: var(--surface);
  }

  .map iframe {
    width: 100%;
    height: 100%;
    border: 0;
    filter: grayscale(1) invert(0.92) contrast(0.85) hue-rotate(180deg);
  }

  .form-body { padding: clamp(1.5rem, 2.8vw, 2.75rem); }

  @media (max-width: 1000px) {
    .layout { grid-template-columns: 1fr; }
  }
</style>
