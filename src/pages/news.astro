---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PressCard from '../components/PressCard.astro';
import { press } from '../data/content';

const [lead, ...rest] = press;
---

<Base
  title="News"
  description="Press coverage and features on Brooke Forbes and Forbes Productions — Heart of Hollywood, Medium, Magic Image Magazine and more."
>
  <PageHero
    eyebrow="Blog · Press · Features"
    title="News"
    lede="Coverage of our films, events and the people behind them."
    media="screen-capture-041"
  />

  <section class="section">
    <div class="wrap">
      <article class="lead card" data-reveal>
        <a class="lead-media" href={lead.href} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true">
          <img
            src={`/media/full/${lead.media}.webp`}
            alt=""
            loading="eager"
            decoding="async"
            width="1600"
            height="900"
            sizes="(max-width: 950px) 92vw, 52vw"
          />
        </a>
        <div class="lead-body">
          <p class="lead-source">{lead.source}{'date' in lead && lead.date ? ` · ${lead.date}` : ''}</p>
          <h2 class="lead-title"><a href={lead.href} target="_blank" rel="noopener noreferrer">{lead.title}</a></h2>
          <p class="lead-excerpt">{lead.excerpt}</p>
          <span class="link-arrow">
            Read full article
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
          </span>
        </div>
      </article>
    </div>
  </section>

  <section class="section band">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Blog</p>
        <h2>Latest Articles</h2>
      </div>

      <div class="grid">
        {rest.map((p, i) => (
          <div data-reveal style={`--reveal-delay:${(i % 3) * 100}ms`}><PressCard {...p} /></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section cta">
    <div class="wrap cta-inner" data-reveal>
      <p class="eyebrow eyebrow-plain">Media enquiries</p>
      <h2>Covering the next one?</h2>
      <p class="lede">Apply for accreditation and red carpet access, or request assets and interviews.</p>
      <div class="btn-row">
        <a class="btn btn-lg" href="/events/stained-red-carpet#press">Apply for press access</a>
        <a class="btn btn-lg btn-ghost" href="/contact">Contact the team</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .band { background: var(--ink-2); border-block: 1px solid var(--line); }

  .lead {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: stretch;
    position: relative;
  }

  .lead:hover { box-shadow: var(--shadow-lift); }

  .lead-media { display: block; overflow: hidden; min-height: 300px; }

  .lead-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease);
  }

  .lead:hover .lead-media img { transform: scale(1.04); }

  .lead-body {
    display: grid;
    align-content: center;
    gap: 0.75rem;
    padding: clamp(1.6rem, 3vw, 3rem);
  }

  .lead-source {
    margin: 0;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .lead-title { margin: 0; font-size: clamp(1.5rem, 2.3vw, 2.5rem); }
  .lead-title a { text-decoration: none; }
  .lead-title a::after { content: ''; position: absolute; inset: 0; }
  .lead-title a:hover { color: var(--gold-soft); }

  .lead-excerpt { margin: 0; color: var(--muted); }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(330px, 1fr));
    gap: clamp(1rem, 1.8vw, 1.75rem);
  }

  .cta {
    text-align: center;
    background: radial-gradient(60% 100% at 50% 100%, rgba(216, 20, 51, 0.2) 0%, transparent 62%), var(--ink-2);
    border-top: 1px solid var(--line);
  }

  .cta-inner .eyebrow { justify-content: center; }
  .cta-inner .lede { margin: 1.2rem auto 2rem; }
  .cta-inner .btn-row { justify-content: center; }

  @media (max-width: 950px) {
    .lead { grid-template-columns: 1fr; }
    /* Clear min-height so aspect-ratio derives height from width, not the
       other way round (which would over-size the image inside the card). */
    .lead-media { min-height: 0; aspect-ratio: 16 / 9; }
  }
</style>
