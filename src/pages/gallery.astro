---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import galleries from '../data/galleries.json';

const { categories } = galleries;
// galleries.json is generated, so its category ids are typed as literal keys.
const items = galleries.items as Record<string, string[]>;
const total = categories.reduce((a, c) => a + c.count, 0);
---

<Base
  title="Gallery"
  description="A visual journey through Forbes Productions — red carpet, fashion, comedy, film stills, portraits and show posters."
>
  <PageHero
    eyebrow={`${total} photographs`}
    title="Gallery"
    lede="A visual journey through our productions, performances and creative moments. Click any image to open it full size; use the arrow keys to move through a set."
    media="models-red-carpet-sexy"
  />

  <nav class="catnav" aria-label="Gallery categories">
    <div class="wrap catnav-inner">
      <ul>
        {categories.map((c) => (
          <li><a href={`#${c.id}`}>{c.title}<span>{c.count}</span></a></li>
        ))}
      </ul>
    </div>
  </nav>

  {categories.map((c, i) => (
    <section class:list={['section', i % 2 === 1 && 'band']} id={c.id}>
      <div class="wrap">
        <div class="section-head split" data-reveal>
          <div>
            <p class="eyebrow">{String(i + 1).padStart(2, '0')} · {c.count} photos</p>
            <h2>{c.title}</h2>
          </div>
          <p class="lede">{c.blurb}</p>
        </div>
        <div data-reveal>
          <PhotoGrid
            items={items[c.id]}
            context={c.title}
            variant={c.id === 'flyers' ? 'masonry' : 'mosaic'}
            row={250}
            min={310}
            eager={i === 0 ? 6 : 0}
          />
        </div>
      </div>
    </section>
  ))}

  <section class="section cta">
    <div class="wrap cta-inner" data-reveal>
      <p class="eyebrow eyebrow-plain">Attended one of our events?</p>
      <h2>Your photos are waiting</h2>
      <p class="lede">Guests and sponsors can access full-resolution downloads in the private event gallery.</p>
      <div class="btn-row">
        <a class="btn btn-lg" href="/event-gallery">Open event gallery</a>
        <a class="btn btn-lg btn-ghost" href="/events">See upcoming events</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .band { background: var(--ink-2); border-block: 1px solid var(--line); }

  .section-head.split {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.25rem 3rem;
  }
  .section-head.split .lede { max-width: 42ch; }

  .catnav {
    position: sticky;
    top: var(--header-h);
    z-index: 40;
    background: rgba(8, 7, 11, 0.9);
    backdrop-filter: blur(14px);
    border-block: 1px solid var(--line);
  }

  .catnav-inner { overflow-x: auto; scrollbar-width: none; }
  .catnav-inner::-webkit-scrollbar { display: none; }

  .catnav ul {
    display: flex;
    gap: 0.5rem;
    margin: 0;
    padding: 0.75rem 0;
    list-style: none;
  }

  /* Wide screens fit every pill, so wrap instead of hiding the last one. */
  @media (min-width: 1200px) {
    .catnav ul { flex-wrap: wrap; justify-content: center; }
  }

  .catnav li { margin: 0; flex: none; }

  .catnav a {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.5rem 1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.25s var(--ease), border-color 0.25s var(--ease), background 0.25s var(--ease);
  }

  .catnav a:hover { color: var(--paper); border-color: var(--red); background: rgba(216, 20, 51, 0.12); }

  .catnav a span {
    font-size: 0.68rem;
    color: var(--gold);
    font-variant-numeric: tabular-nums;
  }

  .cta {
    text-align: center;
    background: radial-gradient(60% 100% at 50% 100%, rgba(216, 20, 51, 0.2) 0%, transparent 62%), var(--ink-2);
    border-top: 1px solid var(--line);
  }

  .cta-inner .eyebrow { justify-content: center; }
  .cta-inner .lede { margin: 1.2rem auto 2rem; }
  .cta-inner .btn-row { justify-content: center; }
</style>
