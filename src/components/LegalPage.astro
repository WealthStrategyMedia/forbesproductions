---
import PageHero from './PageHero.astro';
import { effectiveDate } from '../data/legal';

interface Props {
  title: string;
  sections: { heading: string; body: string[] }[];
}
const { title, sections } = Astro.props;
---

<PageHero eyebrow={`Effective date: ${effectiveDate}`} title={title} />

<section class="section">
  <div class="wrap legal">
    <nav class="toc" aria-label="On this page">
      <p class="toc-h">On this page</p>
      <ol>
        {sections.map((s, i) => (
          <li><a href={`#s${i + 1}`}>{s.heading}</a></li>
        ))}
      </ol>
    </nav>

    <div class="legal-body">
      {sections.map((s, i) => (
        <section class="clause" id={`s${i + 1}`}>
          <h2>{s.heading}</h2>
          {s.body.map((p) => <p>{p}</p>)}
        </section>
      ))}

      <p class="legal-foot">
        Questions about this document? <a href="/contact">Get in touch</a>.
      </p>
    </div>
  </div>
</section>

<style>
  .legal {
    display: grid;
    grid-template-columns: minmax(0, 17rem) minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 4.5rem);
    align-items: start;
  }

  .toc {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
    padding: 1.4rem 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--surface);
  }

  .toc-h {
    margin: 0 0 0.9rem;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .toc ol {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: toc;
    display: grid;
    gap: 0.55rem;
  }

  .toc li { margin: 0; counter-increment: toc; }

  .toc a {
    display: grid;
    grid-template-columns: 1.6rem minmax(0, 1fr);
    font-size: 0.84rem;
    color: var(--muted);
    text-decoration: none;
    line-height: 1.4;
  }

  .toc a::before {
    content: counter(toc, decimal-leading-zero);
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }

  .toc a:hover { color: var(--paper); }

  .legal-body { max-width: 78ch; }

  .clause + .clause { margin-top: clamp(2rem, 3.5vw, 3rem); }

  .clause h2 {
    font-size: clamp(1.35rem, 1.1rem + 1vw, 2rem);
    margin-bottom: 0.7rem;
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }

  .clause p { color: var(--muted); line-height: 1.75; }

  .legal-foot {
    margin-top: clamp(2.5rem, 4vw, 3.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    color: var(--faint);
    font-size: 0.9rem;
  }

  .legal-foot a { color: var(--gold-soft); }

  @media (max-width: 900px) {
    .legal { grid-template-columns: 1fr; }
    .toc { position: static; }
  }
</style>
