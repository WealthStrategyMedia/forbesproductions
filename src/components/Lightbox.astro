---
/**
 * One lightbox for the whole document. Any element carrying `data-zoom`
 * (the full-size URL) opens it; arrow keys walk the group the element sits in,
 * which is every [data-zoom] inside the nearest [data-zoom-group] or the page.
 */
---

<dialog class="lb" id="lightbox" aria-label="Image viewer">
  <div class="lb-stage">
    <!-- src/alt are filled when a tile is opened; hidden keeps it out of the
         a11y tree (and out of the build audit) while it is empty. -->
    <img class="lb-img" alt="" hidden data-lb-img />
    <p class="lb-cap" hidden></p>
  </div>

  <button class="lb-btn lb-close" type="button" data-lb-close aria-label="Close viewer">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
      <path d="M5 5l14 14M19 5L5 19" />
    </svg>
  </button>

  <button class="lb-btn lb-prev" type="button" data-lb-prev aria-label="Previous image">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <path d="M15 5l-7 7 7 7" />
    </svg>
  </button>

  <button class="lb-btn lb-next" type="button" data-lb-next aria-label="Next image">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <path d="M9 5l7 7-7 7" />
    </svg>
  </button>

  <p class="lb-count" aria-live="polite"></p>
</dialog>

<style>
  .lb {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--paper);
    overflow: hidden;
  }

  .lb::backdrop {
    background: rgba(4, 3, 6, 0.93);
    backdrop-filter: blur(14px);
  }

  .lb[open] { display: grid; }

  .lb-stage {
    place-self: center;
    display: grid;
    gap: 0.9rem;
    justify-items: center;
    padding: clamp(2.6rem, 6vh, 4.5rem) clamp(0.75rem, 6vw, 5.5rem);
    max-width: 100%;
    max-height: 100dvh;
  }

  .lb-img {
    max-width: min(1600px, 100%);
    max-height: calc(100dvh - 9.5rem);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 40px 90px -30px rgba(0, 0, 0, 0.9);
    animation: lb-in 0.34s var(--ease);
  }

  @keyframes lb-in {
    from { opacity: 0; transform: scale(0.975); }
    to { opacity: 1; transform: none; }
  }

  .lb-cap {
    margin: 0;
    max-width: 68ch;
    text-align: center;
    font-size: 0.86rem;
    color: var(--muted);
  }

  .lb-btn {
    position: fixed;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: rgba(20, 17, 27, 0.72);
    backdrop-filter: blur(10px);
    color: var(--paper);
    cursor: pointer;
    transition: background 0.25s var(--ease), border-color 0.25s var(--ease), transform 0.25s var(--ease);
  }

  .lb-btn:hover { background: var(--red); border-color: transparent; }

  .lb-close { top: clamp(0.75rem, 2vh, 1.4rem); right: clamp(0.75rem, 2vw, 1.4rem); }
  .lb-prev { left: clamp(0.5rem, 2vw, 1.6rem); top: 50%; transform: translateY(-50%); }
  .lb-next { right: clamp(0.5rem, 2vw, 1.6rem); top: 50%; transform: translateY(-50%); }
  .lb-prev:hover, .lb-next:hover { transform: translateY(-50%) scale(1.06); }

  .lb-count {
    position: fixed;
    bottom: clamp(0.6rem, 2vh, 1.2rem);
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .lb.is-single .lb-prev,
  .lb.is-single .lb-next,
  .lb.is-single .lb-count { display: none; }

  @media (max-width: 680px) {
    .lb-prev { left: 0.4rem; }
    .lb-next { right: 0.4rem; }
    .lb-btn { width: 42px; height: 42px; }
  }
</style>

<script>
  const dlg = document.getElementById('lightbox') as HTMLDialogElement | null;
  if (dlg) {
    const imgEl = dlg.querySelector('.lb-img') as HTMLImageElement;
    const capEl = dlg.querySelector('.lb-cap') as HTMLParagraphElement;
    const countEl = dlg.querySelector('.lb-count') as HTMLParagraphElement;

    let group: HTMLElement[] = [];
    let index = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      if (!group.length) return;
      index = (i + group.length) % group.length;
      const el = group[index];
      const src = el.dataset.zoom!;
      const alt = el.dataset.zoomAlt || '';
      const caption = el.dataset.zoomCaption || '';

      imgEl.src = src;
      imgEl.alt = alt;
      imgEl.hidden = false;
      if (el.dataset.zoomW) imgEl.width = Number(el.dataset.zoomW);
      if (el.dataset.zoomH) imgEl.height = Number(el.dataset.zoomH);

      capEl.textContent = caption || alt;
      capEl.hidden = !(caption || alt);
      countEl.textContent = `${index + 1} / ${group.length}`;
      dlg.classList.toggle('is-single', group.length < 2);

      // Warm the neighbours so arrowing through a gallery feels instant.
      for (const step of [1, -1]) {
        const n = group[(index + step + group.length) % group.length];
        if (n && n !== el) new Image().src = n.dataset.zoom!;
      }
    };

    const open = (el: HTMLElement) => {
      const scope = el.closest('[data-zoom-group]') ?? document;
      group = Array.from(scope.querySelectorAll<HTMLElement>('[data-zoom]'));
      opener = el;
      document.body.classList.add('is-locked');
      show(Math.max(0, group.indexOf(el)));
      if (!dlg.open) dlg.showModal();
    };

    document.addEventListener('click', (e) => {
      const el = (e.target as HTMLElement)?.closest?.('[data-zoom]') as HTMLElement | null;
      if (!el) return;
      e.preventDefault();
      open(el);
    });

    dlg.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('[data-lb-close]')) return dlg.close();
      if (t.closest('[data-lb-prev]')) return show(index - 1);
      if (t.closest('[data-lb-next]')) return show(index + 1);
      // A click on the backdrop (the dialog itself) or the padding closes it.
      if (t === dlg || t.classList.contains('lb-stage')) dlg.close();
    });

    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); show(index + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(index - 1); }
    });

    dlg.addEventListener('close', () => {
      document.body.classList.remove('is-locked');
      imgEl.removeAttribute('src');
      imgEl.hidden = true;
      opener?.focus?.();
      opener = null;
    });

    // Swipe between images on touch devices.
    let sx = 0;
    let sy = 0;
    dlg.addEventListener('touchstart', (e) => {
      sx = e.changedTouches[0].clientX;
      sy = e.changedTouches[0].clientY;
    }, { passive: true });
    dlg.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - sx;
      const dy = e.changedTouches[0].clientY - sy;
      if (Math.abs(dx) > 55 && Math.abs(dx) > Math.abs(dy) * 1.6) show(index + (dx < 0 ? 1 : -1));
    }, { passive: true });
  }
</script>
