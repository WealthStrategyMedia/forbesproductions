---
/**
 * Form shell for every enquiry on the site. Fields are real and validate in
 * the browser, but submission is intercepted and reported as not-yet-wired.
 * Swap `data-form` handling in the script below for the Tweeble endpoint.
 */
import PendingNotice from './PendingNotice.astro';
import type { Field } from '../lib/forms';

interface Props {
  id: string;
  fields: readonly Field[];
  submitLabel: string;
  title?: string;
  note?: string;
}

const { id, fields, submitLabel, title, note } = Astro.props;
---

<form class="sform" id={id} data-form={id} novalidate>
  {title && <h3 class="sform-title">{title}</h3>}
  {note && <p class="sform-note">{note}</p>}

  <div class="sform-grid">
    {fields.map((f) => {
      const fid = `${id}-${f.name}`;
      if (f.type === 'textarea') {
        return (
          <p class="field full">
            <label for={fid}>{f.label}{f.required && <span class="req" aria-hidden="true">*</span>}</label>
            <textarea id={fid} name={f.name} rows={f.rows ?? 5} placeholder={f.placeholder} required={f.required}></textarea>
          </p>
        );
      }
      if (f.type === 'select') {
        return (
          <p class:list={['field', f.half ? 'half' : 'full']}>
            <label for={fid}>{f.label}{f.required && <span class="req" aria-hidden="true">*</span>}</label>
            <select id={fid} name={f.name} required={f.required}>
              <option value="">Please choose…</option>
              {f.options.map((o) => <option value={o}>{o}</option>)}
            </select>
          </p>
        );
      }
      if (f.type === 'checkboxes') {
        return (
          <fieldset class="field full checks">
            <legend>{f.label}</legend>
            <div class="checks-grid">
              {f.options.map((o, i) => (
                <label class="check" for={`${fid}-${i}`}>
                  <input type="checkbox" id={`${fid}-${i}`} name={f.name} value={o} />
                  <span>{o}</span>
                </label>
              ))}
            </div>
          </fieldset>
        );
      }
      if (f.type === 'consent') {
        return (
          <p class="field full consent">
            <label class="check" for={fid}>
              <input type="checkbox" id={fid} name={f.name} required={f.required} />
              <span set:html={f.label} />
            </label>
          </p>
        );
      }
      return (
        <p class:list={['field', f.half ? 'half' : 'full']}>
          <label for={fid}>{f.label}{f.required && <span class="req" aria-hidden="true">*</span>}</label>
          <input type={f.type} id={fid} name={f.name} placeholder={f.placeholder} required={f.required} autocomplete={f.autocomplete} />
        </p>
      );
    })}
  </div>

  <div class="sform-foot">
    <button class="btn btn-lg" type="submit">{submitLabel}</button>
    <PendingNotice kind="form" compact />
  </div>

  <p class="sform-result" data-form-result role="status" aria-live="polite" hidden></p>
</form>

<style>
  .sform {
    display: grid;
    gap: 1.5rem;
  }

  .sform-title { margin: 0; }
  .sform-note { margin: 0; color: var(--muted); font-size: 0.92rem; max-width: 60ch; }

  .sform-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.1rem 1.25rem;
  }

  .field { margin: 0; display: grid; gap: 0.5rem; }
  .field.full { grid-column: 1 / -1; }
  .field.half { grid-column: span 1; }

  label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .req { color: var(--red-bright); margin-left: 0.3em; }

  input[type='text'], input[type='email'], input[type='tel'], input[type='url'], input[type='date'], textarea, select {
    width: 100%;
    padding: 0.85rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--r);
    background: rgba(245, 242, 235, 0.03);
    color: var(--paper);
    font: inherit;
    font-size: 0.95rem;
    transition: border-color 0.25s var(--ease), background 0.25s var(--ease);
  }

  textarea { resize: vertical; min-height: 7.5rem; }

  select {
    appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, var(--muted) 50%), linear-gradient(135deg, var(--muted) 50%, transparent 50%);
    background-position: calc(100% - 20px) calc(1.3rem), calc(100% - 15px) calc(1.3rem);
    background-size: 5px 5px, 5px 5px;
    background-repeat: no-repeat;
  }

  select option { background: var(--surface-2); color: var(--paper); }

  input:focus, textarea:focus, select:focus {
    outline: none;
    border-color: var(--gold);
    background: rgba(245, 242, 235, 0.06);
  }

  input::placeholder, textarea::placeholder { color: rgba(245, 242, 235, 0.3); }

  .checks { border: 0; padding: 0; margin: 0; display: grid; gap: 0.6rem; }
  .checks legend {
    padding: 0;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .checks-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.4rem;
  }

  .check {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    font-size: 0.9rem;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    color: var(--muted);
    cursor: pointer;
  }

  .check input {
    flex: none;
    width: 18px;
    height: 18px;
    margin-top: 0.15em;
    accent-color: var(--red);
  }

  .consent :global(a) { color: var(--gold-soft); }

  .sform-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  .sform-foot :global(.pending) { flex: 1 1 22rem; }

  .sform-result {
    margin: 0;
    padding: 0.9rem 1.1rem;
    border-radius: var(--r);
    border: 1px solid var(--line-strong);
    background: rgba(216, 20, 51, 0.1);
    font-size: 0.88rem;
    color: var(--paper);
  }

  input:user-invalid, textarea:user-invalid, select:user-invalid { border-color: var(--red-bright); }

  @media (max-width: 680px) {
    .sform-grid { grid-template-columns: 1fr; }
    .field.half { grid-column: 1 / -1; }
  }
</style>

<script>
  /*
   * Placeholder submit handler.
   *
   * To go live: POST the FormData to the Tweeble form endpoint here and replace
   * the notice below with the real success / error states. Nothing is sent or
   * persisted in the meantime.
   */
  document.querySelectorAll<HTMLFormElement>('form[data-form]').forEach((form) => {
    const result = form.querySelector<HTMLElement>('[data-form-result]');
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      if (!result) return;
      result.hidden = false;
      result.textContent =
        'Thanks — this form is not connected yet. Submissions will be handled by Tweeble once the integration is switched on. Nothing was sent.';
      result.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    });
  });
</script>
