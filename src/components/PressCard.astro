---
import { asset } from '../lib/media';

interface Props {
  title: string;
  source: string;
  excerpt: string;
  href: string;
  media: string;
  date?: string;
}
const { title, source, excerpt, href, media, date } = Astro.props;
const a = asset(media);
---

<article class="pc card">
  <a class="pc-media" href={href} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true">
    <img src={a.thumb} width={a.width} height={a.height} alt="" loading="lazy" decoding="async" sizes="(max-width: 780px) 92vw, 30vw" />
  </a>

  <div class="pc-body">
    <p class="pc-source">{source}{date && <span class="pc-date"> · {date}</span>}</p>
    <h3 class="pc-title">
      <a href={href} target="_blank" rel="noopener noreferrer">{title}</a>
    </h3>
    <p class="pc-excerpt">{excerpt}</p>
    <span class="link-arrow" aria-hidden="true">
      Read full article
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
    </span>
  </div>
</article>

<style>
  .pc {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .pc:hover { transform: translateY(-4px); box-shadow: var(--shadow-lift); }

  .pc-media {
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--surface);
  }

  .pc-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.85s var(--ease);
  }

  .pc:hover .pc-media img { transform: scale(1.06); }

  .pc-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: clamp(1.25rem, 2vw, 1.85rem);
  }

  .pc-source {
    margin: 0;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .pc-date { color: var(--faint); font-weight: 400; letter-spacing: 0.12em; }

  .pc-title {
    margin: 0;
    font-size: clamp(1.2rem, 1.5vw, 1.55rem);
    line-height: 1.18;
  }

  .pc-title a { text-decoration: none; }

  /* Make the whole card clickable without nesting interactive elements. */
  .pc-title a::after { content: ''; position: absolute; inset: 0; }
  .pc { position: relative; }
  .pc-title a:hover { color: var(--gold-soft); }

  .pc-excerpt {
    flex: 1;
    margin: 0;
    font-size: 0.91rem;
    line-height: 1.6;
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 4;
    line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pc .link-arrow { margin-top: 0.35rem; }
  .pc:hover .link-arrow svg { transform: translateX(5px); }
</style>
