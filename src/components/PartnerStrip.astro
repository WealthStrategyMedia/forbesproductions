---
import { partners } from '../data/site';
import { asset } from '../lib/media';

interface Props { title?: string; eyebrow?: string }
const { title = 'Our Partners', eyebrow = 'In good company' } = Astro.props;

const items = partners.map((p) => ({ ...p, a: asset(p.media) }));
---

<section class="section-tight partners">
  <div class="wrap">
    <div class="section-head partners-head">
      <p class="eyebrow">{eyebrow}</p>
      <h2>{title}</h2>
    </div>

    <ul class="partner-grid">
      {items.map((p) => (
        <li class="partner">
          {p.href ? (
            <a href={p.href} target="_blank" rel="noopener noreferrer" title={p.name}>
              <img src={p.a.thumb} width={p.a.width} height={p.a.height} alt={p.name} loading="lazy" decoding="async" />
            </a>
          ) : (
            <img src={p.a.thumb} width={p.a.width} height={p.a.height} alt={p.name} loading="lazy" decoding="async" />
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .partners { border-top: 1px solid var(--line); }
  .partners-head { text-align: center; margin-bottom: clamp(1.75rem, 3vw, 2.75rem); }
  .partners-head .eyebrow { justify-content: center; }

  .partner-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    align-items: center;
    gap: clamp(1rem, 2.4vw, 2.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .partner {
    margin: 0;
    display: grid;
    place-items: center;
    min-height: 74px;
  }

  .partner img {
    width: auto;
    max-width: 100%;
    max-height: 62px;
    object-fit: contain;
    filter: grayscale(1) brightness(1.7) contrast(0.85);
    opacity: 0.62;
    transition: filter 0.35s var(--ease), opacity 0.35s var(--ease), transform 0.35s var(--ease);
  }

  .partner a { display: block; line-height: 0; }

  .partner:hover img {
    filter: none;
    opacity: 1;
    transform: scale(1.04);
  }
</style>
