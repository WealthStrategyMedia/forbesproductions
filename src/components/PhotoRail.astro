---
/**
 * Horizontal scroll-snap rail of large photo cards. Replaces the carousel
 * widget on the live site, which rendered empty slides.
 */
import { asset, describe } from '../lib/media';

interface Props {
  items: readonly string[];
  context?: string;
  label: string;
  height?: string;
}
const { items, context, label, height = 'clamp(300px, 34vw, 480px)' } = Astro.props;
const tiles = items.map((k) => ({ k, a: asset(k) }));
---

<div class="rail-wrap" data-rail>
  <div class="rail" role="region" aria-label={label} tabindex="0" data-zoom-group data-rail-track>
    {tiles.map(({ k, a }, i) => (
      <button
        type="button"
        class="rail-item"
        style={`--nat:${a.aspect}`}
        data-zoom={a.full}
        data-zoom-w={a.width}
        data-zoom-h={a.height}
        data-zoom-alt={describe(k, context)}
        aria-label={`Enlarge: ${describe(k, context)}`}
      >
        <img
          src={a.thumb}
          width={a.width}
          height={a.height}
          alt={describe(k, context)}
          loading={i < 4 ? 'eager' : 'lazy'}
          decoding="async"
          sizes="(max-width: 700px) 78vw, 33vw"
        />
      </button>
    ))}
  </div>

  <div class="rail-nav">
    <button class="rail-btn" type="button" data-rail-prev aria-label="Scroll left">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7" /></svg>
    </button>
    <button class="rail-btn" type="button" data-rail-next aria-label="Scroll right">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7" /></svg>
    </button>
  </div>
</div>

<style define:vars={{ railH: height }}>
  .rail-wrap { position: relative; }

  .rail {
    display: flex;
    gap: clamp(0.6rem, 1vw, 1rem);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding-inline: var(--gutter);
    padding-block: 0.4rem;
    /* Break out of .wrap so the rail bleeds to both screen edges. */
    margin-inline: calc(50% - 50vw);
    width: 100vw;
    max-width: 100vw;
  }

  .rail::-webkit-scrollbar { display: none; }

  .rail-item {
    flex: none;
    scroll-snap-align: center;
    height: var(--railH);
    aspect-ratio: var(--nat);
    max-width: min(78vw, 640px);
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--r);
    overflow: hidden;
    background: var(--surface);
    cursor: zoom-in;
    transition: border-color 0.35s var(--ease), transform 0.35s var(--ease);
  }

  .rail-item:hover { border-color: rgba(216, 20, 51, 0.6); transform: translateY(-3px); }

  .rail-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease);
  }

  .rail-item:hover img { transform: scale(1.05); }

  .rail-nav {
    display: flex;
    gap: 0.6rem;
    justify-content: flex-end;
    margin-top: 1.1rem;
  }

  .rail-btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: transparent;
    color: var(--paper);
    cursor: pointer;
    transition: background 0.25s var(--ease), border-color 0.25s var(--ease), opacity 0.25s var(--ease);
  }

  .rail-btn:hover { background: var(--red); border-color: transparent; }
  .rail-btn[disabled] { opacity: 0.3; cursor: default; background: transparent; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-rail]').forEach((wrap) => {
    const track = wrap.querySelector<HTMLElement>('[data-rail-track]')!;
    const prev = wrap.querySelector<HTMLButtonElement>('[data-rail-prev]')!;
    const next = wrap.querySelector<HTMLButtonElement>('[data-rail-next]')!;

    const page = () => Math.max(240, track.clientWidth * 0.82);
    const sync = () => {
      const max = track.scrollWidth - track.clientWidth - 2;
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= max;
    };

    prev.addEventListener('click', () => track.scrollBy({ left: -page() }));
    next.addEventListener('click', () => track.scrollBy({ left: page() }));
    track.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync);
    sync();
  });
</script>
