---
/**
 * Click-to-play facade. The Vimeo/YouTube iframe is only injected once the
 * viewer asks for it, which keeps ~700KB of third-party script off first load.
 */
import { asset, describe } from '../lib/media';

interface Props {
  provider: 'vimeo' | 'youtube';
  id: string;
  title: string;
  poster: string;
  ratio?: string;
  class?: string;
}

const { provider, id, title, poster, ratio = '16 / 9', class: className = '' } = Astro.props;
const a = asset(poster);

const src =
  provider === 'vimeo'
    ? `https://player.vimeo.com/video/${id}?autoplay=1&title=1&byline=1&portrait=1&dnt=1`
    : `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
---

<div class:list={['vid', className]} style={`--ratio:${ratio}`} data-video={src} data-video-title={title}>
  <button type="button" class="vid-play" aria-label={`Play video: ${title}`}>
    <img src={a.full} width={a.width} height={a.height} alt={describe(poster, title)} loading="lazy" decoding="async" />
    <span class="vid-scrim" aria-hidden="true"></span>
    <span class="vid-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor"><path d="M8 5.5v13l11-6.5-11-6.5Z" /></svg>
    </span>
    <span class="vid-label">{title}</span>
  </button>
</div>

<style>
  .vid {
    position: relative;
    aspect-ratio: var(--ratio);
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .vid-play {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    color: var(--paper);
  }

  .vid-play img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.66) saturate(0.9);
    transition: transform 0.9s var(--ease), filter 0.5s var(--ease);
  }

  .vid-play:hover img { transform: scale(1.04); filter: brightness(0.74); }

  .vid-scrim {
    position: absolute;
    inset: 0;
    background: radial-gradient(60% 60% at 50% 50%, transparent 0%, rgba(4, 3, 6, 0.55) 100%);
  }

  .vid-icon {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    width: clamp(64px, 7vw, 86px);
    height: clamp(64px, 7vw, 86px);
    border-radius: 999px;
    background: var(--red);
    box-shadow: 0 0 0 0 rgba(216, 20, 51, 0.55);
    transition: transform 0.3s var(--ease), box-shadow 0.4s var(--ease);
    padding-left: 4px;
  }

  .vid-play:hover .vid-icon,
  .vid-play:focus-visible .vid-icon {
    transform: translate(-50%, -50%) scale(1.09);
    box-shadow: 0 0 0 14px rgba(216, 20, 51, 0.16);
  }

  .vid-label {
    position: absolute;
    left: clamp(1rem, 2.5vw, 2rem);
    bottom: clamp(1rem, 2.5vw, 1.75rem);
    right: clamp(1rem, 2.5vw, 2rem);
    font-family: var(--display);
    font-size: clamp(1.1rem, 1.7vw, 1.7rem);
    text-align: left;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.6);
  }

  .vid iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>

<script>
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement)?.closest?.('.vid-play');
    if (!btn) return;
    const host = btn.closest<HTMLElement>('[data-video]');
    if (!host) return;
    const iframe = document.createElement('iframe');
    iframe.src = host.dataset.video!;
    iframe.title = host.dataset.videoTitle || 'Video';
    iframe.allow = 'autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media';
    iframe.allowFullscreen = true;
    iframe.loading = 'lazy';
    host.replaceChildren(iframe);
  });
</script>
